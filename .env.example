# ==============================================================================
# WIZZO SOLUTIONS — PRODUCTION DEPLOYMENT ENVIRONMENT VARIABLES
# ==============================================================================

# 1. DATABASE (Required for Admin, CMS, Applications, Auth, and Dynamic Settings)
# PostgreSQL connection string with SSL support enabled by default.
# Compatible with Neon, Supabase, Railway, Render, AWS RDS, or local Docker.
# Example: postgresql://username:password@ep-sample-1234.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/wizzo_db"

# 2. SESSION AUTHENTICATION (Required)
# Cryptographically strong random string used to sign and verify session JWTs.
# Generate one using: openssl rand -base64 32
SESSION_SECRET="generate-a-secure-random-string-at-least-32-chars-long"

# 3. PUBLIC SITE METADATA & SEO (Recommended)
# Canonical URL for OpenGraph, Twitter cards, sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL="https://wizzosolutions.com"

# 4. NODE ENVIRONMENT (Set automatically by Vercel/Render/Railway)
NODE_ENV="production"

# 5. DOCKER / STANDALONE BUILDS (Optional: set to "true" when building Docker container)
# STANDALONE="true"
