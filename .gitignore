# ==============================================================================
# WIZZO Solutions — .gitignore
# Prevents sensitive credentials, user data, environment secrets, and build
# artifacts from leaking into public or private GitHub repositories.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIDENTIAL ENVIRONMENT SECRETS & API KEYS (CRITICAL)
# ------------------------------------------------------------------------------
# Never commit actual credentials, database connection strings, or JWT session secrets
.env
.env*.local
.env.development
.env.test
.env.production
*.env

# Retain the safe example template for developers
!.env.example

# Private certificates, encryption keys, and credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.credentials
credentials.json
service-account*.json
firebase-adminsdk*.json

# ------------------------------------------------------------------------------
# 2. RUNTIME USER DATA, UPLOADS & LOCAL DATABASES (CONFIDENTIAL)
# ------------------------------------------------------------------------------
# Customer inquiries, lead captures, form submissions, and offline database dumps
data/
!data/.gitkeep
inquiries.json
*.jsonl

# User-uploaded files, resumes, and career applicant CVs
uploads/
cv_uploads/
storage/

# SQLite / Embedded local databases
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
*.db-journal

# ------------------------------------------------------------------------------
# 3. DEPENDENCIES & PACKAGE MANAGERS
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ------------------------------------------------------------------------------
# 4. NEXT.JS & BUILD OUTPUTS
# ------------------------------------------------------------------------------
.next/
out/
build/
dist/
.turbo/

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# 5. TESTING, COVERAGE & TEMPORARY SCREENSHOTS
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Temporary automated test screenshots (root level)
verify-*.png
hero-new*.png
figma-hero*.png
screenshot*.png

# ------------------------------------------------------------------------------
# 6. OPERATING SYSTEM & EDITOR ARTIFACTS
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini

# IDEs & Editor metadata
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Agent & local workflow artifacts
.agents/
.commandcode/
